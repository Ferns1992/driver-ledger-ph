# Copy to .env and edit. Never commit the real .env.
# All values are optional - the defaults shown are what the app uses.

# Seeded only when the drivers table is empty (first boot).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8-chars

# Set to false on a production install that must start empty.
SEED_ON_EMPTY=true

# How long a login stays valid, in hours.
SESSION_TTL_HOURS=12

# Internal port. Not normally changed.
PORT=4090
